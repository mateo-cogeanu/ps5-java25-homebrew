@@ -690,6 +690,25 @@
     }
 #endif
     RESTARTABLE(stat(path, &buf), err);
+#ifdef __PROSPERO__
+    /* The native title sandbox may reject pathname metadata while allowing
+     * open and descriptor metadata. stat follows links, so open+fstat keeps
+     * that policy. Never apply this fallback to lstat (which must not follow).
+     * Only return attributes supplied by the real descriptor operation. */
+    if (err == -1 && errno == EPERM) {
+        int original_error = errno;
+        int fd;
+        RESTARTABLE(open(path, O_RDONLY | O_NONBLOCK), fd);
+        if (fd >= 0) {
+            RESTARTABLE(fstat(fd, &buf), err);
+            int metadata_error = errno;
+            close(fd);
+            errno = metadata_error;
+        } else {
+            errno = original_error;
+        }
+    }
+#endif
     if (err == 0) {
         copy_stat_attributes(env, &buf, attrs);
         return 0;
