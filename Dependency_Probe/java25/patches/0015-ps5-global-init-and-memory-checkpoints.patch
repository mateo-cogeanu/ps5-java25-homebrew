+inline void ps5_vm_trace_memory(const char *operation, const void *address,
+                                size_t bytes, int mode, int error) {
+  int saved_errno = errno;
+  char message[192];
+  snprintf(message, sizeof(message), "%s addr=%p bytes=%zu mode=%d errno=%d",
+           operation, address, bytes, mode, error);
+  ps5_vm_trace(message);
+  errno = saved_errno;
 }
 #else
+inline void ps5_vm_trace_memory(const char *, const void *, size_t, int, int) {}
 inline void ps5_vm_trace(const char *) {}
