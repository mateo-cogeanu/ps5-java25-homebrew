 ifeq ($(call isTargetOs, linux bsd), true)
   HOTSPOT_VERSION_SCRIPT := $(TOPDIR)/make/data/hotspot-symbols/version-script-$(TOOLCHAIN_TYPE).txt
 
+  ifeq ($(PS5_BOOTSTRAP), yes)
+    # PS5's SDK has no ELF _init/_fini stubs. Keep HotSpot exports without
+    # assigning symbol versions to those absent desktop CRT symbols.
+    HOTSPOT_VERSION_SCRIPT := $(TOPDIR)/make/data/hotspot-symbols/version-script-ps5.txt
+  endif
+
   JVM_LDFLAGS += -Wl,-version-script=$(HOTSPOT_VERSION_SCRIPT)
 endif
 
