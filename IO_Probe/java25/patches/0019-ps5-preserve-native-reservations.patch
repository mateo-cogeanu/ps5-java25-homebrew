+// Fixed-size stack formatting for fault context; avoids stdio formatting.
+inline void ps5_vm_trace_hex(const char* label, unsigned long long value) {
+  char line[144];
+  size_t n = 0;
+  while (label[n] && n < sizeof(line) - 20) { line[n] = label[n]; ++n; }
+  line[n++] = '0'; line[n++] = 'x';
+  const char* digits = "0123456789abcdef";
+  for (int shift = 60; shift >= 0; shift -= 4) line[n++] = digits[(value >> shift) & 15];
+  line[n] = 0;
+  ps5_vm_trace(line);
+}
