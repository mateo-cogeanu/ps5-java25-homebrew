  * Return the size of a regular file.
  */
 jlong osSupport::size(const char *path) {
+#ifdef __PROSPERO__
+    // Obtain the readable file length without depending on stat field layout.
+    int fd = ::open(path, O_RDONLY);
+    if (fd < 0) return -1;
+    off_t length = ::lseek(fd, 0, SEEK_END);
+    int error = errno;
+    ::close(fd);
+    if (length < 0) errno = error;
+    return static_cast<jlong>(length);
+#else
     struct stat statbuf;
     if (stat(path, &statbuf) < 0 ||
             (statbuf.st_mode & S_IFREG) != S_IFREG) {
         return -1;
     }
     return (jsize) statbuf.st_size;
+#endif
 }
 
