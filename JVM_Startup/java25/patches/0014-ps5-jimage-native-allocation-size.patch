+#ifdef __PROSPERO__
+static size_t ps5_mapping_size(size_t bytes) {
+    long page = sysconf(_SC_PAGESIZE);
+    if (page <= 0 || bytes == 0) return 0;
+    size_t alignment = static_cast<size_t>(page);
+    if (bytes > SIZE_MAX - (alignment - 1)) return 0;
+    return ((bytes + alignment - 1) / alignment) * alignment;
