diff --git a/src/hotspot/share/runtime/ps5StartupTrace.hpp b/src/hotspot/share/runtime/ps5StartupTrace.hpp
--- a/src/hotspot/share/runtime/ps5StartupTrace.hpp
+++ b/src/hotspot/share/runtime/ps5StartupTrace.hpp
@@ -47,6 +47,21 @@
   line[n] = 0;
   ps5_vm_trace(line);
 }
+inline void ps5_vm_trace_values(const char* a, unsigned long long av,
+                                const char* b, unsigned long long bv,
+                                const char* c, unsigned long long cv) {
+  char line[160]; size_t n = 0;
+  const char* labels[3] = { a, b, c };
+  unsigned long long values[3] = { av, bv, cv };
+  const char* digits = "0123456789abcdef";
+  for (int j = 0; j < 3; ++j) {
+    if (n > sizeof(line) - 19) break;
+    for (size_t i = 0; labels[j][i] && n < sizeof(line) - 20; ++i) line[n++] = labels[j][i];
+    line[n++] = '0'; line[n++] = 'x';
+    for (int shift = 60; shift >= 0; shift -= 4) line[n++] = digits[(values[j] >> shift) & 15];
+  }
+  line[n] = 0; ps5_vm_trace(line);
+}
