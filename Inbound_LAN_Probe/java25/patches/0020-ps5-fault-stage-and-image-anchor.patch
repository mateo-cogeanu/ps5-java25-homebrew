     ps5_vm_trace_hex("SIGNAL: number=", (unsigned long long)sig);
     ps5_vm_trace_hex("SIGNAL: pc=", uc ? (unsigned long long)os::Posix::ucontext_get_pc(uc) : 0);
     ps5_vm_trace_hex("SIGNAL: fault address=", info ? (unsigned long long)info->si_addr : 0);
