+/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
+ * Opt-in final fallback for temporary libjava buffers after libc/anonymous
+ * exhaustion. Each translation unit has an independent 8MiB /64slot budget.
+ * No allocator or lazy-lock allocation. Uncertain cleanup retains ownership.
+ */
+#ifndef PS5_CORE_DIRECT_SCRATCH_H
+#define PS5_CORE_DIRECT_SCRATCH_H
+#ifdef __PROSPERO__
+#include <stdint.h>
+#include <stddef.h>
+#include <errno.h>
+#include <sys/mman.h>
+extern int JNU_PS5DirectScratchEnabled(void);
+extern size_t sceKernelGetDirectMemorySize(void);
+extern int sceKernelAllocateDirectMemory(int64_t,int64_t,size_t,size_t,int,int64_t*);
+extern int sceKernelMapDirectMemory(void**,size_t,int,int,int64_t,size_t);
+extern int sceKernelMunmap(void*,size_t);
+extern int sceKernelReleaseDirectMemory(int64_t,size_t);
+typedef struct {void* address;int64_t physical;size_t bytes;unsigned state;} Ps5ScratchEntry;
+static Ps5ScratchEntry ps5_scratch_entries[64];
+static size_t ps5_scratch_held;
+static unsigned ps5_scratch_lock;
+static void ps5_scratch_acquire(void){while(__atomic_exchange_n(&ps5_scratch_lock,1,__ATOMIC_ACQUIRE)){
+#if defined(__x86_64__)
+ __asm__ volatile("pause");
+#elif defined(__aarch64__)
+ __asm__ volatile("yield");
+#endif
+}}
+static void ps5_scratch_unlock(void){__atomic_store_n(&ps5_scratch_lock,0,__ATOMIC_RELEASE);}
+static void ps5_scratch_forget(unsigned slot){ps5_scratch_held-=ps5_scratch_entries[slot].bytes;ps5_scratch_entries[slot]=(Ps5ScratchEntry){0};}
+static void* ps5_core_scratch_map(size_t bytes){
+ int saved=errno;
+ void* memory=mmap(NULL,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0);
+ if(memory!=MAP_FAILED)return memory;
+ if(errno!=ENOMEM||!JNU_PS5DirectScratchEnabled())return MAP_FAILED;
+ const size_t page=16384,budget=8*1024*1024;
+ if(!bytes||bytes%page||bytes>budget){errno=ENOMEM;return MAP_FAILED;}
+ unsigned slot=64;ps5_scratch_acquire();
+ if(ps5_scratch_held<=budget-bytes)for(unsigned i=0;i<64;i++)if(!ps5_scratch_entries[i].state){slot=i;break;}
+ if(slot<64){ps5_scratch_entries[slot].state=1;ps5_scratch_entries[slot].bytes=bytes;ps5_scratch_held+=bytes;}
+ ps5_scratch_unlock();if(slot==64){errno=ENOMEM;return MAP_FAILED;}
+ size_t pool=sceKernelGetDirectMemorySize();int64_t physical=-1;
+ int rc=pool>=bytes&&pool<=INT64_MAX?sceKernelAllocateDirectMemory(0,(int64_t)pool,bytes,page,12,&physical):-1;
+ if(rc){ps5_scratch_acquire();ps5_scratch_forget(slot);ps5_scratch_unlock();errno=ENOMEM;return MAP_FAILED;}
+ void* address=(void*)(uintptr_t)0x1000000000ULL;
+ rc=sceKernelMapDirectMemory(&address,bytes,PROT_READ|PROT_WRITE,0,physical,page);
+ int unmapped=0,released=0;
+ if(rc||!address||address==MAP_FAILED||(uintptr_t)address%page){
+  if(!rc)unmapped=sceKernelMunmap(address,bytes);
+  released=unmapped==0?sceKernelReleaseDirectMemory(physical,bytes):-1;
+  ps5_scratch_acquire();ps5_scratch_entries[slot].physical=physical;
+  if(unmapped==0&&released==0)ps5_scratch_forget(slot);
+  else{ps5_scratch_entries[slot].address=rc?NULL:address;ps5_scratch_entries[slot].state=3;}
+  ps5_scratch_unlock();errno=ENOMEM;return MAP_FAILED;
+ }
+ ps5_scratch_acquire();ps5_scratch_entries[slot]=(Ps5ScratchEntry){address,physical,bytes,2};ps5_scratch_unlock();errno=saved;return address;
+}
+static int ps5_core_scratch_unmap(void* address,size_t bytes){
+ int saved=errno;unsigned slot=64;ps5_scratch_acquire();
+ for(unsigned i=0;i<64;i++)if(ps5_scratch_entries[i].state&&ps5_scratch_entries[i].address==address){slot=i;break;}
+ if(slot==64){ps5_scratch_unlock();return munmap(address,bytes);}
+ Ps5ScratchEntry entry=ps5_scratch_entries[slot];
+ if(entry.state!=2||entry.bytes!=bytes){ps5_scratch_unlock();errno=EINVAL;return -1;}
+ ps5_scratch_entries[slot].state=3;ps5_scratch_unlock();
+ int rc=sceKernelMunmap(address,bytes);
+ int released=rc==0?sceKernelReleaseDirectMemory(entry.physical,bytes):-1;
+ ps5_scratch_acquire();if(rc==0&&released==0)ps5_scratch_forget(slot);ps5_scratch_unlock();
+ if(rc||released){errno=EIO;return -1;}errno=saved;return 0;
+}
+#endif
+#endif
