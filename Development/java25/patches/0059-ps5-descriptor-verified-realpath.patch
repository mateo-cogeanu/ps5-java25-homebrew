+/* Conservative fallback for realpath EPERM: verify each component through
+ * anchored, non-following native opens. No lexical existence or link bypass.
+ * Paths requiring link resolution remain errors when native realpath fails. */
+static int ps5_descriptor_realpath(const char*path,char*resolved) {
+    if (!path || path[0]!='/') {errno=EINVAL;return -1;}
+    size_t length=strnlen(path,PATH_MAX+1);
+    if(length>PATH_MAX){errno=ENAMETOOLONG;return -1;}
+    int fd;
+    do{fd=open("/",O_RDONLY|O_NONBLOCK|O_DIRECTORY|O_NOFOLLOW);}while(fd<0&&errno==EINTR);
+    if(fd<0)return -1;
+    resolved[0]='/';resolved[1]=0;size_t used=1,pos=1;
+    while(pos<length){
+        while(pos<length&&path[pos]=='/')++pos;
+        if(pos==length)break;
+        size_t start=pos;while(pos<length&&path[pos]!='/')++pos;
+        size_t count=pos-start;char component[NAME_MAX+1];
+        if(count>NAME_MAX){int error=ENAMETOOLONG;close(fd);errno=error;return -1;}
+        memcpy(component,path+start,count);component[count]=0;
+        int dot=strcmp(component,".")==0,parent=strcmp(component,"..")==0;
+        int flags=O_RDONLY|O_NONBLOCK|O_NOFOLLOW;
+        if(pos<length||dot||parent)flags|=O_DIRECTORY;
+        int next;
+        do{next=openat(fd,component,flags);}while(next<0&&errno==EINTR);
+        if(next<0){int error=errno;close(fd);errno=error;return -1;}
+        if(close(fd)<0){int error=errno;close(next);errno=error;return -1;}fd=next;
+        if(parent){while(used>1&&resolved[used-1]!='/')--used;if(used>1)--used;resolved[used]=0;}
+        else if(!dot){
+            if(used>1)resolved[used++]='/';
+            if(used+count>PATH_MAX){int error=ENAMETOOLONG;close(fd);errno=error;return -1;}
+            memcpy(resolved+used,component,count);used+=count;resolved[used]=0;
+        }
+    }
+    return close(fd);
+}
+#endif
