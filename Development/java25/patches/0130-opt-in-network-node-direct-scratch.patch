 #include <sys/mman.h>
+#ifdef __PROSPERO__
+/* Independent default-off policy; reuse the bounded temporary mapper. */
+#define JNU_PS5DirectScratchEnabled JNU_PS5NetworkScratchEnabled
+#include "ps5_core_direct_scratch.h"
+#undef JNU_PS5DirectScratchEnabled
+#endif
