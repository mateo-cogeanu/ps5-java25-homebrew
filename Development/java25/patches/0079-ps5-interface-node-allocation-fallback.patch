--- /dev/null
+++ b/src/java.base/unix/native/libnet/ps5NetifAlloc.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */
+#ifndef PS5_NETIF_ALLOC_H
+#define PS5_NETIF_ALLOC_H
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <sys/mman.h>
+#ifndef PS5_NETIF_ALLOC_NOTE
+#define PS5_NETIF_ALLOC_NOTE(phase,bytes) ((void)0)
+#endif
+/* All interface-list nodes carry the same aligned owner prefix, including
+ * libc successes. No resident getifaddrs pointers use this allocator. */
+typedef union {max_align_t alignment; size_t mapped;} Ps5NetifAllocation;
+static void *ps5_netif_allocate(size_t size) {
+    int saved=errno;
+    const size_t page=16384;
+    if (size>SIZE_MAX-sizeof(Ps5NetifAllocation)-(page-1)) {errno=ENOMEM;return NULL;}
+    size_t bytes=sizeof(Ps5NetifAllocation)+(size?size:1);
+    Ps5NetifAllocation *owner=malloc(bytes);
+    if (owner) owner->mapped=0;
+    else {
+        PS5_NETIF_ALLOC_NOTE("node libc refused",size);
+        size_t mapped=(bytes+page-1)&~(page-1);
+        errno=0;
+        owner=mmap(NULL,mapped,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0);
+        if (owner==MAP_FAILED) {PS5_NETIF_ALLOC_NOTE("node mapping failed",mapped);return NULL;}
+        owner->mapped=mapped;
+        PS5_NETIF_ALLOC_NOTE("node mapped",mapped);
+    }
+    errno=saved;return owner+1;
+}
+static void ps5_netif_release(void *value) {
+    if (!value) return;
+    int saved=errno;
+    Ps5NetifAllocation *owner=(Ps5NetifAllocation *)value-1;
+    if (owner->mapped) munmap(owner,owner->mapped); else free(owner);
+    errno=saved;
+}
+#endif
