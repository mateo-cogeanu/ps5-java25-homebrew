+/* Re-query current flags when the desktop ioctl is denied. Lookup does
+ * not fabricate a missing interface or reuse an earlier enumeration. */
+static int ps5_ifaddrs_get_flags(const char *name,int *flags) {
+    int saved=errno;
+    Ps5Ifaddrs storage={0};struct ifaddrs *list=NULL;
+    if (ps5_getifaddrs(&list,&storage)<0) return -1;
+    for (struct ifaddrs *item=list;item;item=item->ifa_next) {
+        if (item->ifa_name && strcmp(name,item->ifa_name)==0) {
+            *flags=(int)item->ifa_flags;
+            ps5_freeifaddrs(list,&storage);
+            PS5_IFADDRS_NOTE("route flags resolved",*flags);
+            errno=saved;return 0;
+        }
+    }
+    ps5_freeifaddrs(list,&storage);errno=ENODEV;return -1;
+}
 #endif
