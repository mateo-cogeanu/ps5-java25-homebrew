+        private static int ps5OpenLimit() {
+            String value = jdk.internal.misc.VM.getSavedProperty("ps5.zip.maxOpenFiles");
+            if (value != null) {
+                try {
+                    int limit = Integer.parseInt(value);
+                    if (limit >= 8 && limit <= 128) return limit;
+                } catch (NumberFormatException ignored) {}
+            }
+            return 0;
+        }
+
+        // All pooled I/O and eviction share one lock, so a handle cannot be
+        // evicted between seek and read, even with concurrent entry streams.
+        private static void ps5MakeRoom() throws IOException {
+            while (ps5OpenFiles.size() >= PS5_OPEN_LIMIT) {
+                var iterator = ps5OpenFiles.keySet().iterator();
+                Source idle = iterator.next();
+                idle.zfile.close();
+                idle.zfile = null;
+                iterator.remove();
+            }
+        }
