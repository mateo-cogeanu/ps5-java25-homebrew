+        private void ps5CheckIdentity() throws IOException {
+            BasicFileAttributes observed = Files.readAttributes(
+                    builtInFS.getPath(key.file.getPath()), BasicFileAttributes.class);
+            if (!observed.isRegularFile() || observed.size() != key.attrs.size()
+                    || !observed.lastModifiedTime().equals(key.attrs.lastModifiedTime())
+                    || !Objects.equals(observed.fileKey(), key.attrs.fileKey())) {
+                throw new ZipException("ZIP changed while its descriptor was released: " + key.file);
+            }
+        }
+
+        private RandomAccessFile ps5File() throws IOException {
+            assert Thread.holdsLock(ps5OpenFiles);
+            if (ps5Closed) throw new ZipException("ZIP source closed");
+            if (zfile == null) {
+                ps5CheckIdentity();
+                ps5MakeRoom();
+                RandomAccessFile opened = new RandomAccessFile(key.file, "r");
+                try { ps5CheckIdentity(); }
+                catch (IOException failure) { opened.close(); throw failure; }
+                zfile = opened;
+                ps5OpenFiles.put(this, Boolean.TRUE);
+            } else {
+                ps5OpenFiles.get(this); // update least-recently-used order
+            }
+            return zfile;
+        }
