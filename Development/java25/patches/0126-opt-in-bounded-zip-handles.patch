+        // Explicit opt-in for applications with immutable ZIP/JAR inputs and
+        // a smaller title filesystem handle budget than RLIMIT_NOFILE reports.
+        private static final int PS5_OPEN_LIMIT = ps5OpenLimit();
+        private static final LinkedHashMap<Source, Boolean> ps5OpenFiles =
+                new LinkedHashMap<>(16, 0.75f, true);
+        private final boolean ps5Pooled;
+        private boolean ps5Closed;
