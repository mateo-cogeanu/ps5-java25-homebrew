+/* Temporary bulk-I/O buffers are independent of the HotSpot native heap.
+ * Retain the exact mapping length: writeBytes consumes its len argument.
+ */
+static void *io_scratch_allocate(size_t bytes, size_t *mapped_size)
+{
+    *mapped_size = 0;
+#ifdef __PROSPERO__
+    int saved_errno = errno;
+    errno = 0;
+#endif
+    void *buffer = malloc(bytes);
+#ifdef __PROSPERO__
+    if (buffer == NULL) {
+        int heap_error = errno;
+        long page = sysconf(_SC_PAGESIZE);
+        if (page <= 0 || bytes > SIZE_MAX - ((size_t)page - 1)) {
+            errno = ENOMEM;
+            return NULL;
+        }
+        size_t rounded = ((bytes + (size_t)page - 1) / (size_t)page) * (size_t)page;
+        buffer = mmap(NULL, rounded, PROT_READ | PROT_WRITE,
+                      MAP_PRIVATE | MAP_ANON, -1, 0);
+        int map_error = buffer == MAP_FAILED ? errno : 0;
+        jio_fprintf(stderr, "PS5 file I/O scratch: bytes=%zu malloc_errno=%d "
+                    "mapped_bytes=%zu mmap_errno=%d\n", bytes, heap_error,
+                    buffer == MAP_FAILED ? 0 : rounded, map_error);
+        if (buffer == MAP_FAILED) { errno = map_error; return NULL; }
+        *mapped_size = rounded;
+    }
+    errno = saved_errno;
+#endif
+    return buffer;
+}
+
+static void io_scratch_release(void *buffer, size_t mapped_size)
+{
+#ifdef __PROSPERO__
+    int saved_errno = errno;
+    if (mapped_size != 0) munmap(buffer, mapped_size);
+    else free(buffer);
+    errno = saved_errno;
+#else
+    free(buffer);
+#endif
+}
