+    // Optional PS5 diagnosis for network exceptions swallowed by callers. Keep
+    // normal exception identity/message/cause and never log raw exception text.
+    private static int ps5SocketTraces;
+    private static void traceSocketFailure(String text) {
+        try {
+            if (!Boolean.getBoolean("sun.nio.fs.ps5Sandbox") ||
+                !Boolean.getBoolean("ps5.net.traceBindFailures")) return;
+            StackTraceElement[] frames = new Throwable().getStackTrace();
+            boolean network = false;
+            for (StackTraceElement frame : frames) {
+                String owner = frame.getClassName(), method = frame.getMethodName();
+                if ((owner.equals("sun.nio.ch.Net") &&
+                    (method.startsWith("bind") || method.equals("listen") || method.startsWith("socket")))) network = true;
+            }
+            if (!network || System.err == null) return;
+            synchronized (IOException.class) {
+                if (ps5SocketTraces >= 32) return;
+                ps5SocketTraces++;
+                String category = text == null ? "NO_DETAIL" :
+                    text.contains("already in use") ? "ADDRESS_IN_USE" :
+                    text.contains("Permission denied") || text.contains("not permitted") ? "PERMISSION" :
+                    text.contains("assign requested address") ? "ADDRESS_UNAVAILABLE" :
+                    text.contains("Too many open files") ? "FILE_LIMIT" :
+                    text.contains("not supported") || text.contains("unavailable") ? "CAPABILITY" :
+                    text.contains("Invalid argument") ? "INVALID_ARGUMENT" : "OTHER";
+                System.err.println("PS5_HOST_IO event=" + ps5SocketTraces + " type=" + "java.io.IOException" + " category=" + category);
+                for (int n = 0; n < Math.min(frames.length, 12); n++)
+                    System.err.println("PS5_HOST_IO frame=" + frames[n].getClassName() + "." + frames[n].getMethodName());
+            }
+        } catch (Throwable diagnosticFailure) {
+            // A diagnostic must never replace the original I/O exception.
+        }
+    }
+
