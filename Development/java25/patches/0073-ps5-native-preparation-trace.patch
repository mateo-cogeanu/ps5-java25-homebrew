+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SHARE_RUNTIME_PS5NATIVEMETHODTRACE_HPP
+#define SHARE_RUNTIME_PS5NATIVEMETHODTRACE_HPP
+#ifdef __PROSPERO__
+#include <stddef.h>
+#include <stdint.h>
+#include "runtime/ps5StartupTrace.hpp"
+// Fixed stack formatting of length-delimited Symbol bytes. No ResourceMark,
+// as_C_string, heap allocation, locks or new TLS initialization.
+inline void ps5_trace_native_part(char* line, size_t* used, const unsigned char* bytes,
+                                 size_t length, size_t cap) {
+  size_t count = length < cap ? length : cap;
+  for (size_t i=0; bytes && i<count; ++i) {
+    unsigned char c=bytes[i]; line[(*used)++]=(c>=32 && c<127)?(char)c:'?';
+  }
+  if (length>cap) line[(*used)++]='~';
+}
+inline void ps5_trace_native_method(const char* stage,
+        const unsigned char* holder, size_t holder_len,
+        const unsigned char* name, size_t name_len,
+        const unsigned char* signature, size_t signature_len, uintptr_t target) {
+  char line[384]; size_t used=0;
+  ps5_trace_native_part(line,&used,(const unsigned char*)stage,stage?::strlen(stage):0,48);
+  line[used++]=' ';
+  ps5_trace_native_part(line,&used,holder,holder_len,80);line[used++]='.';
+  ps5_trace_native_part(line,&used,name,name_len,80);
+  ps5_trace_native_part(line,&used,signature,signature_len,160);line[used]=0;
+  ps5_vm_trace(line);
+  ps5_vm_trace_values("PS5 native prepare target=",target," self=",(uintptr_t)pthread_self()," phase=",0);
+}
+#endif
+#endif
