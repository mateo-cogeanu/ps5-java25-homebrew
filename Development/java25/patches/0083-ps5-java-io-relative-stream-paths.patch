+#ifdef __PROSPERO__
+/* java.io streams pass relative File paths directly to native open. Resolve
+ * through File's existing user.dir policy because PS5 has no usable desktop
+ * process cwd. Absolute and empty paths keep their existing semantics. */
+static jstring ps5_io_absolute_path(JNIEnv *env, jstring path) {
+    if ((*env)->GetStringLength(env, path) == 0) return path;
+    jchar first;
+    (*env)->GetStringRegion(env, path, 0, 1, &first);
+    if ((*env)->ExceptionCheck(env)) return NULL;
+    if (first == '/') return path;
+    jobject file = JNU_NewObjectByName(env, "java/io/File",
+                                     "(Ljava/lang/String;)V", path);
+    if (file == NULL) return NULL;
+    jvalue result = JNU_CallMethodByName(env, NULL, file,
+                                        "getAbsolutePath", "()Ljava/lang/String;");
+    (*env)->DeleteLocalRef(env, file);
+    if ((*env)->ExceptionCheck(env)) return NULL;
+    return (jstring)result.l;
+}
+#endif
