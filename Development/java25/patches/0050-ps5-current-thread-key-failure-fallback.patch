+// Raw little-endian words preserve the signal ABI evidence without trusting
+// the SDK's register offsets. Bound reads to the supplied object and 256 bytes.
+inline void ps5_vm_trace_raw_context(const void* context, size_t bytes) {
+  if (!context) return;
+  const unsigned char* data=(const unsigned char*)context;
+  for (size_t offset=0; offset+16<=bytes && offset<256; offset+=16) {
+    unsigned long long a=0,b=0;
+    for (unsigned n=0;n<8;++n) {
+      a |= (unsigned long long)data[offset+n] << (n*8);
+      b |= (unsigned long long)data[offset+8+n] << (n*8);
+    }
+    ps5_vm_trace_values("SIGNAL: raw context offset=",offset," word0=",a," word1=",b);
+  }
+}
