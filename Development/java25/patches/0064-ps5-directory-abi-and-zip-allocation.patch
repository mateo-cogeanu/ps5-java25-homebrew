+#ifndef PS5_ZIP_ALLOC_H
+#define PS5_ZIP_ALLOC_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/mman.h>
+/* One ownership prefix for the stream and zlib's private allocations. */
+typedef union {max_align_t alignment;struct{size_t mapped;}owner;} Ps5ZipAllocation;
+static void* ps5_zip_calloc(size_t count,size_t size) {
+    int saved=errno;
+    if(size&&count>SIZE_MAX/size){errno=ENOMEM;return NULL;}
+    size_t bytes=count*size;
+    if(bytes>SIZE_MAX-sizeof(Ps5ZipAllocation)){errno=ENOMEM;return NULL;}
+    size_t total=bytes+sizeof(Ps5ZipAllocation);
+    Ps5ZipAllocation*base=malloc(total);size_t mapped=0;
+    if(base==NULL){
+        const size_t page=16384;
+        if(total>SIZE_MAX-(page-1)){errno=ENOMEM;return NULL;}
+        mapped=(total+page-1)&~(page-1);
+        base=mmap(NULL,mapped,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+        if(base==MAP_FAILED)return NULL;
+    }
+    base->owner.mapped=mapped;void*result=base+1;memset(result,0,bytes);errno=saved;return result;
+}
+static void ps5_zip_free(void*value) {
+    if(!value)return;
+    int saved=errno;Ps5ZipAllocation*base=(Ps5ZipAllocation*)value-1;
+    if(base->owner.mapped)munmap(base,base->owner.mapped);else free(base);
+    errno=saved;
+}
+static voidpf ps5_zip_zalloc(voidpf opaque,uInt count,uInt size){(void)opaque;return ps5_zip_calloc(count,size);}
+static void ps5_zip_zfree(voidpf opaque,voidpf value){(void)opaque;ps5_zip_free(value);}
+#endif
