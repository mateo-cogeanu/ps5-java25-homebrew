@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */
+#ifndef LIBJIMAGE_IMAGE_RESOURCE_BUFFER_HPP
+#define LIBJIMAGE_IMAGE_RESOURCE_BUFFER_HPP
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <stdio.h>
+#ifdef __PROSPERO__
+#include <sys/mman.h>
+#endif
+#ifndef IMAGE_BUFFER_MALLOC
+#define IMAGE_BUFFER_MALLOC malloc
+#define IMAGE_BUFFER_FREE free
+#define IMAGE_BUFFER_MMAP mmap
+#define IMAGE_BUFFER_MUNMAP munmap
+#endif
+// Ownership is local to each temporary buffer; never replace process allocators.
+union ImageBufferOwner { max_align_t alignment; size_t mapped; };
+static unsigned char* image_buffer_allocate(size_t bytes) {
+    int saved=errno;
+    if(bytes>SIZE_MAX-sizeof(ImageBufferOwner)){errno=ENOMEM;return NULL;}
+    size_t total=bytes+sizeof(ImageBufferOwner),mapped=0;
+    ImageBufferOwner* base=(ImageBufferOwner*)IMAGE_BUFFER_MALLOC(total);
+#ifdef __PROSPERO__
+    if(!base) {
+        const size_t page=16384;
+        if(total>SIZE_MAX-(page-1)){errno=ENOMEM;return NULL;}
+        mapped=(total+page-1)&~(page-1);
+        void* p=IMAGE_BUFFER_MMAP(NULL,mapped,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+        if(p!=MAP_FAILED)base=(ImageBufferOwner*)p;
+    }
+#endif
+    if(!base){fprintf(stderr,"JIMAGE resource buffer allocation failed bytes=%zu errno=%d\n",bytes,errno);return NULL;}
+    base->mapped=mapped;errno=saved;return (unsigned char*)(base+1);
+}
+static void image_buffer_release(void* buffer) {
+    if(!buffer)return;
+    int saved=errno;ImageBufferOwner* base=(ImageBufferOwner*)buffer-1;
+#ifdef __PROSPERO__
+    if(base->mapped)IMAGE_BUFFER_MUNMAP(base,base->mapped);else
+#endif
+    IMAGE_BUFFER_FREE(base);
+    errno=saved;
+}
+#endif
