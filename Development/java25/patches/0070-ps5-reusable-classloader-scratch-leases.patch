+/* Four exclusive reusable32KiB buffers. No allocator, TLS, or lazy mutex
+ * initialization is needed to lease them. Recursive/concurrent callers never
+ * share a lease; exhaustion falls through to the original real backends. */
+typedef struct {
+    unsigned leased;
+    ClassLoaderScratchHeader header;
+    unsigned char bytes[32768];
+} ClassLoaderScratchSlot;
+static ClassLoaderScratchSlot classloader_scratch_slots[4];
+static void *classloader_scratch_lease(size_t size)
+{
+    if (size > sizeof(classloader_scratch_slots[0].bytes)) return NULL;
+    for (unsigned i = 0; i < 4; ++i) {
+        unsigned expected = 0;
+        if (__atomic_compare_exchange_n(&classloader_scratch_slots[i].leased,
+                &expected, 1, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+            classloader_scratch_slots[i].header.mapped_size = SIZE_MAX;
+            return &classloader_scratch_slots[i].header + 1;
+        }
+    }
+    return NULL;
+}
