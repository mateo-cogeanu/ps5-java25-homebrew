@@ -575,6 +575,16 @@
 
   LogTarget(Trace, gc, classhisto) lt;
   if (lt.is_enabled()) {
+#ifdef __PROSPERO__
+    // Opt-in retained-heap diagnosis: no extra collection. Sample only after
+    // existing full GC with >=512MiB retained, at most3samples16GCs apart.
+    static unsigned ps5_histogram_eligible = 0;
+    static unsigned ps5_histogram_printed = 0;
+    if (before || used() < 512 * M || ps5_histogram_printed >= 3) return;
+    if ((ps5_histogram_eligible++ % 16) != 0) return;
+    ++ps5_histogram_printed;
+    log_trace(gc, classhisto)("PS5 retained histogram sample=%u max=3 stride=16 min_retained_bytes=%zu", ps5_histogram_printed, (size_t)(512 * M));
+#endif
     GCTraceTime(Trace, gc, classhisto) tm(before ? "Class Histogram (before full gc)" : "Class Histogram (after full gc)", timer);
     LogStream ls(lt);
     VM_GC_HeapInspection inspector(&ls, false /* ! full gc */);
