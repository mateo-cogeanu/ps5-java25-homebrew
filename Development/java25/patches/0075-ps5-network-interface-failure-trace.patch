+/* Bounded descriptor-only diagnostics: no FILE, heap, TLS or JNI allocation. */
+static void ps5_netif_note(const char *phase, long value, int pending) {
+    int saved = errno;
+    char text[192];
+    int length = snprintf(text, sizeof(text),
+        "PS5 netif: %s value=%ld pending=%d errno=%d\n", phase, value, pending, saved);
+    if (length > 0 && (size_t)length < sizeof(text)) {
+        int fd = open("/download0/java25-vm-trace.log", O_CREAT|O_WRONLY|O_APPEND, 0600);
+        if (fd >= 0) {
+            size_t offset = 0;
+            while (offset < (size_t)length) {
+                ssize_t n = write(fd, text + offset, (size_t)length - offset);
+                if (n < 0 && errno == EINTR) continue;
+                if (n <= 0) break;
+                offset += (size_t)n;
+            }
+            close(fd);
+        }
+    }
+    errno = saved;
+}
+#define NETIF_NOTE(phase,value) ps5_netif_note(phase, (long)(value), (*env)->ExceptionCheck(env))
+#else
+#define NETIF_NOTE(phase,value) ((void)0)
+#endif
