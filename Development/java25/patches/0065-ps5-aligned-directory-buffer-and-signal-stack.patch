+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SHARE_RUNTIME_PS5SIGNALSTACK_HPP
+#define SHARE_RUNTIME_PS5SIGNALSTACK_HPP
+#include <stdint.h>
+#include <stddef.h>
+// Best-effort native evidence only. The caller supplies actual thread bounds.
+// Never follow a non-increasing frame pointer or read beyond those bounds.
+inline bool ps5_signal_stack_pair(uintptr_t at,uintptr_t low,uintptr_t high,uintptr_t*first,uintptr_t*second) {
+    if(at%sizeof(uintptr_t)||at<low||high<low||at>high||high-at<2*sizeof(uintptr_t))return false;
+    const volatile uintptr_t*p=reinterpret_cast<const volatile uintptr_t*>(at);
+    *first=p[0];*second=p[1];return true;
+}
+template<class Emit> inline void ps5_signal_stack_snapshot(uintptr_t sp,uintptr_t fp,uintptr_t low,uintptr_t high,Emit emit) {
+    uintptr_t a,b;
+    for(unsigned n=0;n<16;n++){
+        if(sp>UINTPTR_MAX-n*2*sizeof(uintptr_t))break;
+        uintptr_t at=sp+n*2*sizeof(uintptr_t);
+        if(!ps5_signal_stack_pair(at,low,high,&a,&b))break;
+        emit(false,at,a,b);
+    }
+    for(unsigned n=0;n<16;n++){
+        if(!ps5_signal_stack_pair(fp,low,high,&a,&b))break;
+        emit(true,fp,a,b);
+        if(a<=fp)break;
+        fp=a;
+    }
+}
+#endif
