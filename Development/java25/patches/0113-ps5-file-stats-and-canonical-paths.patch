+static char *ps5_canonical_realpath(const char *path, char *resolved) {
+    char *result = realpath(path, resolved);
+    if (result == NULL && errno == EPERM &&
+        ps5_descriptor_realpath(path, resolved) == 0) {
+        result = resolved;
+    }
