+/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */
+#ifndef PS5_NATIVE_MEMORY_H
+#define PS5_NATIVE_MEMORY_H
+#include <stddef.h>
+#include "jni.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Shared VM ledger: MAP_FAILED on refusal; zero on successful release.
+ * These helpers neither safepoint nor require an initialized JavaThread.
+ * Call only for owned native data, never Java heap or executable mappings. */
+JNIEXPORT void* JNICALL JVM_PS5MapNativeMemory(size_t bytes);
+JNIEXPORT int JNICALL JVM_PS5UnmapNativeMemory(void* address,size_t bytes);
+#ifdef __cplusplus
+}
+#endif
+#endif
