+#ifdef __PROSPERO__
+// Native-library pressure shares the raw allocator's exact ledger/budget.
+// No JNI transition or JavaThread dependency: image decoding also uses this
+// path during early bootstrap. Only native data can use these CPU RW mappings.
+extern "C" JNIEXPORT void* JNICALL JVM_PS5MapNativeMemory(size_t bytes) {
+  int saved=errno;
+  void* result=ps5_native_direct::map(bytes);
+  ps5_native_direct::report();
+  if(result!=MAP_FAILED)errno=saved;
+  return result;
+}
+extern "C" JNIEXPORT int JNICALL JVM_PS5UnmapNativeMemory(void* address,size_t bytes) {
+  int saved=errno,result=-1;
+  if(!ps5_native_direct::unmap(address,bytes,&result))errno=EINVAL;
+  ps5_native_direct::report();
+  if(result==0)errno=saved;
+  return result;
+}
+#endif
