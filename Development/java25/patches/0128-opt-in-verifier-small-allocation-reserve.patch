+        header = verify_small_allocate(bytes);
+        if (header != NULL) {
+            header->mapped = 0;
+            errno = saved_errno;
+            return header + 1;
+        }
         long page = sysconf(_SC_PAGESIZE);
         if (page <= 0 || bytes > SIZE_MAX - ((size_t)page - 1)) { errno = ENOMEM; return NULL; }
         size_t mapped = ((bytes + (size_t)page - 1) / (size_t)page) * (size_t)page;
