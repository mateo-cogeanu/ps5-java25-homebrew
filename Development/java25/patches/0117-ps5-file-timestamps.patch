+#ifdef __PROSPERO__
+// The title SDK exposes timeval APIs; do not issue newer BSD timestamp syscalls.
+// Floor negative nanoseconds, retaining a nonnegative subsecond component.
+static void ps5_timeval(jlong nanos, struct timeval* value) {
+    jlong seconds = nanos / 1000000000;
+    jlong remainder = nanos % 1000000000;
+    if (remainder < 0) {
+        --seconds;
+        remainder += 1000000000;
+    }
+    value->tv_sec = seconds;
+    value->tv_usec = remainder / 1000;
+}
+#endif
