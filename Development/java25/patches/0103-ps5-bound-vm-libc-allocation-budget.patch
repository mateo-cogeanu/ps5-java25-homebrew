+// Bound only VM-owned libc blocks, including prefixes and in-flight requests.
+// SDK services (notably pthread creation) cannot use the VM page fallback.
+// This is not a guarantee about libc capacity or system-wide native headroom.
+inline constexpr size_t libc_budget = 2 * 1024 * 1024;
+inline size_t* libc_held_word() { static size_t bytes = 0; return &bytes; }
+inline size_t libc_held() { return __atomic_load_n(libc_held_word(), __ATOMIC_RELAXED); }
+inline bool reserve_libc(size_t bytes) {
+  size_t held = libc_held();
+  while (bytes <= libc_budget && held <= libc_budget - bytes) {
+    if (__atomic_compare_exchange_n(libc_held_word(), &held, held + bytes,
+                                    false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) return true;
+  }
+  return false;
+}
+inline void release_libc(size_t bytes) {
+  __atomic_fetch_sub(libc_held_word(), bytes, __ATOMIC_RELAXED);
+}
