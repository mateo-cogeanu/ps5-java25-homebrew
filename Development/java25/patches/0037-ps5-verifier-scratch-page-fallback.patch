+/* Use real anonymous RW pages if the PS5 libc heap cannot supply scratch.
+ * These blocks never cross the verifier boundary and must be released with
+ * their matching backend. Verification and OOM propagation stay unchanged.
+ */
+static struct CCpool *CCpool_allocate(size_t bytes)
+{
+#ifdef __PROSPERO__
+    int saved_errno = errno;
+    errno = 0;
+#endif
+    struct CCpool *pool = (struct CCpool *)malloc(bytes);
+#ifdef __PROSPERO__
+    if (pool != NULL) {
+        pool->mapped_size = 0;
+        errno = saved_errno;
+    } else {
+        int heap_error = errno;
+        long page_size = sysconf(_SC_PAGESIZE);
+        if (page_size <= 0 || bytes > SIZE_MAX - (size_t)page_size) {
+            errno = ENOMEM;
+            return NULL;
+        }
+        size_t mapped = ((bytes + (size_t)page_size - 1) /
+                          (size_t)page_size) * (size_t)page_size;
+        void *memory = mmap(NULL, mapped, PROT_READ | PROT_WRITE,
+                            MAP_PRIVATE | MAP_ANON, -1, 0);
+        int map_error = memory == MAP_FAILED ? errno : 0;
+        jio_fprintf(stderr, "PS5 verifier scratch: bytes=%zu malloc_errno=%d "
+                    "mapped_bytes=%zu mmap_errno=%d\n",
+                    bytes, heap_error, mapped, map_error);
+        if (memory == MAP_FAILED) {
+            errno = map_error;
+            return NULL;
+        }
+        pool = (struct CCpool *)memory;
+        pool->mapped_size = mapped;
+        errno = saved_errno;
+    }
+#endif
+    return pool;
+}
+
+static void CCpool_release(struct CCpool *pool)
+{
+#ifdef __PROSPERO__
+    if (pool->mapped_size != 0) {
+        munmap(pool, pool->mapped_size);
+        return;
+    }
+#endif
+    free(pool);
+}
