+
+/* PS5 pipe writes can fail with ENOMEM after the server is running. A
+ * pre-registered user event needs no pipe buffer for subsequent wakeups.
+ * Keep the ordinary pipe backend on other platforms and on kernels that
+ * explicitly reject the user filter; genuine allocation errors still fail.
+ */
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_KQueue_registerUserWakeup(JNIEnv *env, jclass clazz, jint kqfd)
+{
+#ifdef __PROSPERO__
+    struct kevent event;
+    int res;
+    EV_SET(&event, 0, EVFILT_USER, EV_ADD | EV_CLEAR, 0, 0, 0);
+    RESTARTABLE(kevent(kqfd, &event, 1, NULL, 0, NULL), res);
+    if (res < 0) {
+        if (errno == EINVAL || errno == ENOTSUP || errno == ENOSYS) {
+            jio_fprintf(stderr, "PS5 selector wakeup: user events unsupported; pipe backend\n");
+            return 0;
+        }
+        JNU_ThrowIOExceptionWithLastError(env, "Register selector user event");
+        return 0;
+    }
+    jio_fprintf(stderr, "PS5 selector wakeup: registered user event\n");
+    return EVFILT_USER;
+#else
+    return 0;
+#endif
+}
+
+JNIEXPORT void JNICALL
+Java_sun_nio_ch_KQueue_triggerUserWakeup(JNIEnv *env, jclass clazz, jint kqfd)
+{
+#ifdef __PROSPERO__
+    struct kevent event;
+    int res;
+    EV_SET(&event, 0, EVFILT_USER, 0, NOTE_TRIGGER, 0, 0);
+    RESTARTABLE(kevent(kqfd, &event, 1, NULL, 0, NULL), res);
+    if (res < 0) {
+        JNU_ThrowIOExceptionWithLastError(env, "Trigger selector user event");
+    }
+#else
+    JNU_ThrowIOException(env, "Selector user events are not enabled");
+#endif
+}
