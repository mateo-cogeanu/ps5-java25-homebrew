 extern "C" JNIEXPORT void* JNICALL JVM_PS5MapNativeMemory(size_t bytes) {
   int saved=errno;
   void* result=ps5_native_direct::map(bytes);
+  ps5_native_direct::report();
+  if(result!=MAP_FAILED)errno=saved;
