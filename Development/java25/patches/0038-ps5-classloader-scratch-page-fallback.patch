+/* Temporary class-file and UTF buffers remain local to this native file.
+ * The PS5 libc heap may refuse them while anonymous OS pages remain available.
+ * Track the backend explicitly so cleanup never passes mapped storage to free.
+ */
+#ifdef __PROSPERO__
+typedef union {
+    size_t mapped_size;
+    max_align_t alignment;
+} ClassLoaderScratchHeader;
+#endif
+
+static void *classloader_scratch_allocate(size_t size)
+{
+#ifdef __PROSPERO__
+    int saved_errno = errno;
+    size_t bytes;
+    ClassLoaderScratchHeader *header;
+    if (size > SIZE_MAX - sizeof(*header)) { errno = ENOMEM; return NULL; }
+    bytes = sizeof(*header) + (size == 0 ? 1 : size);
+    errno = 0;
+    header = (ClassLoaderScratchHeader *)malloc(bytes);
+    if (header != NULL) {
+        header->mapped_size = 0;
+    } else {
+        int heap_error = errno;
+        long page = sysconf(_SC_PAGESIZE);
+        if (page <= 0 || bytes > SIZE_MAX - (size_t)page) { errno = ENOMEM; return NULL; }
+        size_t mapped = ((bytes + (size_t)page - 1) / (size_t)page) * (size_t)page;
+        void *memory = mmap(NULL, mapped, PROT_READ | PROT_WRITE,
+                            MAP_PRIVATE | MAP_ANON, -1, 0);
+        int map_error = memory == MAP_FAILED ? errno : 0;
+        jio_fprintf(stderr, "PS5 classloader scratch: bytes=%zu malloc_errno=%d "
+                    "mapped_bytes=%zu mmap_errno=%d\n", size, heap_error, mapped, map_error);
+        if (memory == MAP_FAILED) { errno = map_error; return NULL; }
+        header = (ClassLoaderScratchHeader *)memory;
+        header->mapped_size = mapped;
+    }
+    errno = saved_errno;
+    return header + 1;
+#else
+    return malloc(size);
+#endif
+}
+
+static void classloader_scratch_release(void *buffer)
+{
+#ifdef __PROSPERO__
+    if (buffer != NULL) {
+        ClassLoaderScratchHeader *header = ((ClassLoaderScratchHeader *)buffer) - 1;
+        if (header->mapped_size != 0) munmap(header, header->mapped_size);
+        else free(header);
+    }
+#else
+    free(buffer);
+#endif
+}
