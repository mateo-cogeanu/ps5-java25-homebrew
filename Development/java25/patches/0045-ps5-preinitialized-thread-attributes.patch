+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PS5_THREAD_ATTRIBUTES_HPP
+#define PS5_THREAD_ATTRIBUTES_HPP
+#include <pthread.h>
+#include <errno.h>
+// Real pthread attributes initialized before native-heap pressure. Slots are
+// borrowed exclusively, passed by address without copying opaque objects, and
+// retained for the process lifetime. pthread_create consumes attributes before
+// it returns; the lease may then return its slot even for a detached child.
+namespace ps5_thread_attributes {
+constexpr unsigned capacity = 32;
+struct Slot { pthread_attr_t value; bool valid, busy; };
+inline Slot* slots() { static Slot values[capacity] = {}; return values; }
+inline unsigned* state() { static unsigned value = 0; return &value; }
+inline unsigned* lock_word() { static unsigned value = 0; return &value; }
+inline void pause() {
+#if defined(__x86_64__)
+    __asm__ volatile("pause");
+#elif defined(__aarch64__)
+    __asm__ volatile("yield");
+#endif
+}
+inline void lock() { while (__atomic_exchange_n(lock_word(),1u,__ATOMIC_ACQUIRE)) pause(); }
+inline void unlock() { __atomic_store_n(lock_word(),0u,__ATOMIC_RELEASE); }
+inline void initialize() {
+    unsigned expected = 0;
+    if (__atomic_compare_exchange_n(state(),&expected,1u,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)) {
+        for (unsigned i=0;i<capacity;++i) slots()[i].valid = pthread_attr_init(&slots()[i].value) == 0;
+        __atomic_store_n(state(),2u,__ATOMIC_RELEASE);
+    } else while (__atomic_load_n(state(),__ATOMIC_ACQUIRE) != 2u) pause();
+}
+class Lease {
+    Slot* slot = nullptr;
+    pthread_attr_t local;
+    bool local_valid = false;
+public:
+    pthread_attr_t* value = nullptr;
+    Lease() = default;
+    Lease(const Lease&) = delete;
+    Lease& operator=(const Lease&) = delete;
+    int acquire() {
+        initialize();
+        lock();
+        for (unsigned i=0;i<capacity;++i) if (slots()[i].valid && !slots()[i].busy) {
+            slot=&slots()[i]; slot->busy=true; value=&slot->value; break;
+        }
+        unlock();
+        if (slot != nullptr) return 0;
+        int result=pthread_attr_init(&local);
+        if (result == 0) { local_valid=true; value=&local; }
+        return result;
+    }
+    void release() {
+        int saved_errno=errno;
+        if (slot != nullptr) { lock(); slot->busy=false; unlock(); slot=nullptr; }
+        if (local_valid) { pthread_attr_destroy(&local); local_valid=false; }
+        value=nullptr; errno=saved_errno;
+    }
+    ~Lease() { release(); }
+};
+}
+#endif
