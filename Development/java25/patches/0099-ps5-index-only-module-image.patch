  * Read nBytes at offset into a buffer.
  */
 jlong osSupport::read(jint fd, char *buf, jlong nBytes, jlong offset) {
+#ifdef __PROSPERO__
+    if(nBytes<0 || offset<0 || nBytes>LLONG_MAX-offset) {errno=EINVAL;return -1;}
+    jlong completed=0;
+    while(completed<nBytes) {
+        size_t request=(size_t)((nBytes-completed)>1024*1024?1024*1024:nBytes-completed);
+        ssize_t got=::pread(fd,buf+completed,request,offset+completed);
+        if(got>0)completed+=got;
+        else if(got<0 && errno==EINTR)continue;
+        else return got<0?-1:completed;
+    }
+    return completed;
+#else
     return ::pread(fd, buf, nBytes, offset);
+#endif
 }
 
