+// At most one empty slab per class stays warm (<=8*64KiB). Reclaim it
+// before propagating mapping pressure. Live allocations are never displaced.
+inline void trim_idle_locked() {
+  for (unsigned index=0;index<8;++index) {
+    Slab** link=&classes()[index];
+    while (*link) {
+      Slab* slab=*link;
+      if (slab->live==0) {*link=slab->next;munmap(slab,slab->mapped);}
+      else link=&slab->next;
+    }
+  }
+}
+inline void trim_idle() {
+  int saved=errno;lock();trim_idle_locked();unlock();errno=saved;
+}
