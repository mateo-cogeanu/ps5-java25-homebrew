--- /dev/null
+++ b/src/java.base/unix/native/libjava/PS5SeedGenerator.c
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */
+#ifdef __PROSPERO__
+#include <jni.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <stdio.h>
+// API and64-byte request size used by the pinned SDK hello_sprx sample.
+extern int sceRandomGetRandomNumber(uint8_t *, size_t);
+static void seed_error(JNIEnv *env,const char *name,const char *message) {
+    jclass type=(*env)->FindClass(env,name);
+    if(type!=NULL) { (*env)->ThrowNew(env,type,message); (*env)->DeleteLocalRef(env,type); }
+}
+JNIEXPORT void JNICALL
+Java_sun_security_provider_NativeSeedGenerator_getPS5SeedBytes(JNIEnv *env, jclass type, jbyteArray output) {
+    (void)type;
+    if (output == NULL) {
+        seed_error(env,"java/lang/NullPointerException","seed output");
+        return;
+    }
+    static int announced;
+    jsize length = (*env)->GetArrayLength(env,output);
+    uint8_t bytes[64];
+    for (jsize offset=0; offset<length;) {
+        jsize count=length-offset; if(count>64)count=64;
+        int result=sceRandomGetRandomNumber(bytes,(size_t)count);
+        if(result!=0) {
+            memset(bytes,0,sizeof(bytes));
+            seed_error(env,"java/security/ProviderException","PS5 OS entropy request failed");
+            return;
+        }
+        if(!__atomic_exchange_n(&announced,1,__ATOMIC_RELAXED))
+            fputs("PS5_OS_ENTROPY_OK native service; no threaded seed fallback\n",stderr);
+        (*env)->SetByteArrayRegion(env,output,offset,count,(const jbyte*)bytes);
+        memset(bytes,0,sizeof(bytes));
+        if((*env)->ExceptionCheck(env))return;
+        offset+=count;
+    }
+}
+#endif
