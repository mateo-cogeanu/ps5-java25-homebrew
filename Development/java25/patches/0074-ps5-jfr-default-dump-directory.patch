+// PS5 does not provide the desktop current-directory query used by JFR.
+// The application-visible download directory is a real dump destination;
+// normal file-open/write failures are still handled by the existing code.
+static char* get_default_dump_directory(char* buffer, size_t size) {
+#ifdef __PROSPERO__
+  static const char directory[] = "/download0";
+  if (buffer == nullptr || size < sizeof(directory)) return nullptr;
+  memcpy(buffer, directory, sizeof(directory));
+  return buffer;
+#else
+  return os::get_current_directory(buffer, size);
+#endif
+}
