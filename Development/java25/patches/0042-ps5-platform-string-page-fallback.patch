+/* Platform-char buffers are released through JNU_ReleaseStringPlatformChars. */
+#ifdef __PROSPERO__
+typedef union {
+    size_t mapped_size;
+    max_align_t alignment;
+} PlatformStringHeader;
+#endif
+
+static void *platform_string_allocate(size_t size)
+{
+#ifdef __PROSPERO__
+    int saved_errno = errno;
+    size_t bytes;
+    PlatformStringHeader *header;
+    if (size > SIZE_MAX - sizeof(*header)) { errno = ENOMEM; return NULL; }
+    bytes = sizeof(*header) + (size == 0 ? 1 : size);
+    errno = 0;
+    header = (PlatformStringHeader *)malloc(bytes);
+    if (header != NULL) {
+        header->mapped_size = 0;
+    } else {
+        int heap_error = errno;
+        long page = sysconf(_SC_PAGESIZE);
+        if (page <= 0 || bytes > SIZE_MAX - (size_t)page) { errno = ENOMEM; return NULL; }
+        size_t mapped = ((bytes + (size_t)page - 1) / (size_t)page) * (size_t)page;
+        void *memory = mmap(NULL, mapped, PROT_READ | PROT_WRITE,
+                            MAP_PRIVATE | MAP_ANON, -1, 0);
+        int map_error = memory == MAP_FAILED ? errno : 0;
+        jio_fprintf(stderr, "PS5 platform string: bytes=%zu malloc_errno=%d "
+                    "mapped_bytes=%zu mmap_errno=%d\n", size, heap_error, memory == MAP_FAILED ? 0 : mapped, map_error);
+        if (memory == MAP_FAILED) { errno = map_error; return NULL; }
+        header = (PlatformStringHeader *)memory;
+        header->mapped_size = mapped;
+    }
+    errno = saved_errno;
+    return header + 1;
+#else
+    return malloc(size);
+#endif
+}
+
+static void platform_string_release(void *buffer)
+{
+#ifdef __PROSPERO__
+    int saved_errno = errno;
+    if (buffer != NULL) {
+        PlatformStringHeader *header = ((PlatformStringHeader *)buffer) - 1;
+        if (header->mapped_size != 0) munmap(header, header->mapped_size);
+        else free(header);
+    }
+    errno = saved_errno;
+#else
+    free(buffer);
+#endif
+}
