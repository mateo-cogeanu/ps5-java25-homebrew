+#ifdef __PROSPERO__
+/* File-based trust-store discovery must observe real descriptor metadata when
+ * desktop stat/access are denied. Never infer existence or execute access. */
+static int ps5_file_stat(const char *path, struct stat *observed) {
+    int result; RESTARTABLE(stat(path,observed),result);
+    if (result==0 || errno!=EPERM) return result;
+    int fd; RESTARTABLE(open(path,O_RDONLY|O_NONBLOCK),fd);
+    if (fd<0) return -1;
+    RESTARTABLE(fstat(fd,observed),result);
+    int error=errno;
+    if (close(fd)<0 && result==0) return -1;
+    errno=error;return result;
+}
+static int ps5_file_access(const char *path,int mode) {
+    int result; RESTARTABLE(access(path,mode),result);
+    if (result==0 || errno!=EPERM || (mode&~(R_OK|W_OK))!=0) return result;
+    int flags=O_NONBLOCK|((mode&W_OK)?((mode&R_OK)?O_RDWR:O_WRONLY):O_RDONLY);
+    int fd; RESTARTABLE(open(path,flags),fd);
+    if (fd<0) return -1;
+    struct stat observed;
+    RESTARTABLE(fstat(fd,&observed),result);
+    int error=errno;
+    if (result==0 && !S_ISREG(observed.st_mode) && !S_ISDIR(observed.st_mode)) {result=-1;error=EPERM;}
+    if (close(fd)<0 && result==0) return -1;
+    errno=error;return result;
+}
+#define FILE_STAT ps5_file_stat
+#define FILE_ACCESS ps5_file_access
+#else
+#define FILE_STAT stat
+#define FILE_ACCESS access
+#endif
