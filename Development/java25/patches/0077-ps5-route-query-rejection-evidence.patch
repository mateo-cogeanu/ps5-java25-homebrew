+/* Capture at most2KiB of rejected current kernel data into the existing trace.
+ * Each32-byte hex row fits the bounded native writer. No allocation or FILE. */
+static void ps5_ifaddrs_snapshot(const unsigned char *data,size_t size) {
+    int saved=errno;
+    size_t captured=size<2048?size:2048;
+    PS5_IFADDRS_NOTE("route rejected bytes total",size);
+    PS5_IFADDRS_NOTE("route rejected bytes captured",captured);
+    for (size_t offset=0;offset<captured;offset+=32) {
+        char label[112];
+        int prefix=snprintf(label,sizeof(label),"route hex %04zx ",offset);
+        if (prefix<0 || (size_t)prefix>=sizeof(label)) break;
+        size_t used=(size_t)prefix;
+        static const char hex[]="0123456789abcdef";
+        size_t count=captured-offset<32?captured-offset:32;
+        for(size_t i=0;i<count;i++) {
+            label[used++]=hex[data[offset+i]>>4];
+            label[used++]=hex[data[offset+i]&15];
+        }
+        label[used]=0;
+        PS5_IFADDRS_NOTE(label,count);
+    }
+    errno=saved;
+}
