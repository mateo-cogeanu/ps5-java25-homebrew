+        if (exact != nullptr) {
+          ps5_vm_trace_values("PS5 metaspace exact reservation: bytes=", size, " alignment=", alignment, " address=", (uintptr_t)exact);
+          return exact;
+        }
+      }
+      if (candidate > UINTPTR_MAX - alignment) break;
+      candidate += alignment;
+    }
