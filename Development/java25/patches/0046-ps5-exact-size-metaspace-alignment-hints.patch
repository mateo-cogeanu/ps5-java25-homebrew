--- a/src/hotspot/share/memory/memoryReserver.cpp
+++ b/src/hotspot/share/memory/memoryReserver.cpp
@@ -106,6 +106,27 @@
     fatal("os::release_memory failed");
   }
 
+#ifdef __PROSPERO__
+  // Over-reserving size+alignment can exceed the title's available native
+  // memory even when an exact-size reservation succeeded above. Try nearby
+  // aligned hints through the non-replacing OS API before over-reservation.
+  if (!exec && mem_tag == mtMetaspace && base != nullptr) {
+    uintptr_t original = (uintptr_t)base;
+    uintptr_t candidate = original & ~(uintptr_t)(alignment - 1);
+    for (unsigned i = 0; i < 8; ++i) {
+      if (candidate != 0 && candidate <= UINTPTR_MAX - size) {
+        char* exact = os::attempt_reserve_memory_at((char*)candidate, size, mem_tag, exec);
+        if (exact != nullptr) {
+          ps5_vm_trace_values("PS5 metaspace exact reservation: bytes=", size, " alignment=", alignment, " address=", (uintptr_t)exact);
+          return exact;
+        }
+      }
+      if (candidate > UINTPTR_MAX - alignment) break;
+      candidate += alignment;
+    }
+  }
+#endif
+
   // Map using the requested alignment.
   return os::reserve_memory_aligned(size, alignment, mem_tag, exec);
 }
