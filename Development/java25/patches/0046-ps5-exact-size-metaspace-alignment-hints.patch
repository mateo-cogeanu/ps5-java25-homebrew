   }
+
+#ifdef __PROSPERO__
+  // Over-reserving size+alignment can exceed the title's available native
+  // memory even when an exact-size reservation succeeded above. Try nearby
+  // aligned hints through the non-replacing OS API before over-reservation.
+  if (!exec && mem_tag == mtMetaspace && base != nullptr) {
