+#ifndef SHARE_RUNTIME_PS5PTHREADCHECKS_HPP
+#define SHARE_RUNTIME_PS5PTHREADCHECKS_HPP
+#ifdef __PROSPERO__
+#include "runtime/ps5StartupTrace.hpp"
+inline void ps5_pthread_check(bool valid,int status,const char*operation) {
+  if (!valid) {
+    ps5_vm_trace("FAIL: PS5 native synchronization status");
+    ps5_vm_trace_values(operation,(unsigned int)status," self=",(uintptr_t)pthread_self()," errno=",(unsigned int)errno);
+    guarantee(false,"PS5 native synchronization %s failed with status %d",operation,status);
+  }
+}
+#define PS5_PTHREAD_CHECK(p,status,msg) ps5_pthread_check((p),(status),(msg))
+#else
+#define PS5_PTHREAD_CHECK(p,status,msg) assert_status(p,status,msg)
+#endif
+#endif
