diff --git a/make/autoconf/basic.m4 b/make/autoconf/basic.m4
index 02c477f4c..34e2ce852 100644
--- a/make/autoconf/basic.m4
+++ b/make/autoconf/basic.m4
@@ -351 +351,11 @@ AC_DEFUN_ONCE([BASIC_SETUP_DEVKIT],
-    BASIC_SETUP_XCODE_SYSROOT
+    if test "x$OPENJDK_TARGET_OS" = "xmacosx"; then
+      BASIC_SETUP_XCODE_SYSROOT
+    else
+      # Cross builds need separate target and host SDKs. Xcode is only
+      # the host SDK and must not leak into PS5/FreeBSD compiler flags.
+      target_sysroot="$SYSROOT"
+      SYSROOT=
+      BASIC_SETUP_XCODE_SYSROOT
+      BUILD_SYSROOT="$SYSROOT"
+      SYSROOT="$target_sysroot"
+    fi
diff --git a/make/autoconf/libraries.m4 b/make/autoconf/libraries.m4
index af4db7caf..f83da6ce1 100644
--- a/make/autoconf/libraries.m4
+++ b/make/autoconf/libraries.m4
@@ -83,0 +84,26 @@ AC_DEFUN_ONCE([LIB_DETERMINE_DEPENDENCIES],
+  # PS5 bootstrap excludes java.desktop; it is not a complete JDK image.
+  AC_ARG_ENABLE([ps5-bootstrap], [AS_HELP_STRING([--enable-ps5-bootstrap],
+      [configure only for experimental PS5 HotSpot/java.base bootstrap])],
+      [PS5_BOOTSTRAP="$enableval"], [PS5_BOOTSTRAP=no])
+  if test "x$PS5_BOOTSTRAP" = xyes; then
+    if test "x$OPENJDK_TARGET_OS_ENV" != xbsd.freebsd ||
+        test "x$ENABLE_HEADLESS_ONLY" != xtrue; then
+      AC_MSG_ERROR([PS5 bootstrap requires a headless FreeBSD target])
+    fi
+    AC_COMPILE_IFELSE([AC_LANG_SOURCE([[
+#ifndef __PROSPERO__
+#error PS5 bootstrap requires the PS5 compiler
+#endif
+int ps5_bootstrap;
+    ]])], [], [AC_MSG_ERROR([PS5 bootstrap requires the PS5 compiler])])
+    NEEDS_LIB_X11=false
+    NEEDS_LIB_ALSA=false
+    NEEDS_LIB_CUPS=false
+    NEEDS_LIB_FONTCONFIG=false
+    NEEDS_LIB_FREETYPE=false
+    AC_MSG_WARN([PS5 bootstrap: build only HotSpot and java.base; desktop is unsupported])
+  elif test "x$PS5_BOOTSTRAP" != xno; then
+    AC_MSG_ERROR([--enable-ps5-bootstrap accepts only yes or no])
+  fi
+  AC_SUBST(PS5_BOOTSTRAP)
+
@@ -193,2 +219,5 @@ AC_DEFUN_ONCE([LIB_SETUP_MISC_LIBS],
