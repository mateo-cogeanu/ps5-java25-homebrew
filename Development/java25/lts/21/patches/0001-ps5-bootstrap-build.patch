@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SHARE_RUNTIME_PS5LTSBOOTSTRAP_HPP
+#define SHARE_RUNTIME_PS5LTSBOOTSTRAP_HPP
+#ifdef __PROSPERO__
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+// A fixed small probe log; no stdio, VM allocation or VM lock is needed.
+inline void ps5_lts_trace(const char *text) {
+  int saved = errno;
+  int fd = ::open("/download0/java21-vm-trace.log", O_CREAT | O_WRONLY | O_APPEND, 0600);
+  if (fd >= 0) {
+    size_t left = ::strlen(text), sent = 0;
+    while (sent < left) {
+      ssize_t n = ::write(fd, text + sent, left - sent);
+      if (n > 0) sent += static_cast<size_t>(n);
+      else if (n < 0 && errno == EINTR) continue;
+      else break;
+    }
+    (void)::write(fd, "\n", 1);
+    (void)::close(fd);
+  }
+  errno = saved;
+}
+#else
+inline void ps5_lts_trace(const char *) {}
+#endif
+#endif
