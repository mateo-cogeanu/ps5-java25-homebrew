--- /dev/null
+++ b/src/java.base/share/native/libjimage/ps5ImageArray.hpp
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PS5_IMAGE_ARRAY_HPP
+#define PS5_IMAGE_ARRAY_HPP
+
+#ifdef __PROSPERO__
+#include <stddef.h>
+extern "C" void* JVM_PS5AllocateNativeScratch(size_t size);
+extern "C" void JVM_PS5ReleaseNativeScratch(void* buffer);
+
+template <typename T>
+T* jimage_new_array(size_t count) {
+    if (count <= static_cast<size_t>(-1) / sizeof(T)) {
+        if (void* buffer = JVM_PS5AllocateNativeScratch(count * sizeof(T))) {
+            return static_cast<T*>(buffer);
+        }
+    }
+    // Preserve the resident no-exceptions allocation failure contract.
+    __builtin_trap();
+}
+
+#define JIMAGE_NEW_ARRAY(type, count) jimage_new_array<type>(count)
+#define JIMAGE_DELETE_ARRAY(buffer) JVM_PS5ReleaseNativeScratch(buffer)
+#else
+#define JIMAGE_NEW_ARRAY(type, count) new type[count]
+#define JIMAGE_DELETE_ARRAY(buffer) delete[] buffer
+#endif
+
+#endif
