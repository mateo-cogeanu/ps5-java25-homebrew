+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PS5_THREAD_LOCAL_HPP
+#define PS5_THREAD_LOCAL_HPP
+#include <pthread.h>
+#include <stdint.h>
+// Bounded, allocation-free storage only when the native key setter refuses an
+// update. A null value is a real override (e.g. a refused detach/clear).
+// JNI clients must still detach before their native thread exits.
+namespace ps5_thread_local {
+constexpr unsigned capacity = 1024;
+struct Slot { uintptr_t owner, value; bool active; };
+inline Slot* slots() { static Slot table[capacity] = {}; return table; }
+inline Slot* find(bool create) {
+  uintptr_t key=(uintptr_t)pthread_self();
+  if (!key) return nullptr;
+  unsigned start=(unsigned)(key>>4)%capacity;
+  for(unsigned n=0;n<capacity;++n) {
+    Slot* slot=&slots()[(start+n)%capacity];
+    uintptr_t owner=__atomic_load_n(&slot->owner,__ATOMIC_ACQUIRE);
+    if(owner==key) return slot;
+    if(!create && owner==0) return nullptr;
+    if(create && owner==0) {
+      uintptr_t expected=0;
+      if(__atomic_compare_exchange_n(&slot->owner,&expected,key,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE) || expected==key) return slot;
+    }
+  }
+  return nullptr;
+}
+inline bool get(void** value) {
+  Slot* slot=find(false);
+  if(!slot || !__atomic_load_n(&slot->active,__ATOMIC_ACQUIRE)) return false;
+  *value=(void*)__atomic_load_n(&slot->value,__ATOMIC_ACQUIRE);return true;
+}
+inline bool set(void* value) {
+  Slot* slot=find(true);
+  if(!slot) return false;
+  __atomic_store_n(&slot->value,(uintptr_t)value,__ATOMIC_RELEASE);
+  __atomic_store_n(&slot->active,true,__ATOMIC_RELEASE);return true;
+}
+inline void clear_override() {
+  Slot* slot=find(false);
+  if(slot) {
+    __atomic_store_n(&slot->active,false,__ATOMIC_RELEASE);
+    __atomic_store_n(&slot->value,(uintptr_t)0,__ATOMIC_RELEASE);
+    // Retain the identity so lookups may stop at the first never-used slot.
+    // At most 1024 distinct identities may require fallback in one process.
+  }
+}
+}
+#endif
