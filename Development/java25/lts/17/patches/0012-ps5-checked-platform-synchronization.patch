+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SHARE_RUNTIME_PS5SYNCHRONIZATION_HPP
+#define SHARE_RUNTIME_PS5SYNCHRONIZATION_HPP
+#include <pthread.h>
+#ifdef __PROSPERO__
+#include <errno.h>
+#include <stddef.h>
+namespace ps5_sync {
+template<class Handle,size_t Count> struct Pool {
+ struct Slot {Handle native;bool initialized,busy;};
+ Slot slots[Count];unsigned lock_word,ready;
+ void lock(){while(__atomic_exchange_n(&lock_word,1u,__ATOMIC_ACQUIRE)){
+  while(__atomic_load_n(&lock_word,__ATOMIC_RELAXED)){
+#if defined(__x86_64__)
+   __asm__ volatile("pause");
+#elif defined(__aarch64__)
+   __asm__ volatile("yield");
+#endif
+  }
+ }}
+ void unlock(){__atomic_store_n(&lock_word,0u,__ATOMIC_RELEASE);}
+ template<class Init,class Attr> size_t prime(Init initialize,Attr*attr){
+  size_t count=0;
+  for(auto&s:slots){s.initialized=initialize(&s.native,attr)==0;if(s.initialized)++count;}
+  __atomic_store_n(&ready,1u,__ATOMIC_RELEASE);return count;
+ }
+ Handle* acquire(){
+  if(!__atomic_load_n(&ready,__ATOMIC_ACQUIRE))return nullptr;
+  Handle* result=nullptr;lock();
+  for(auto&s:slots)if(s.initialized&&!s.busy){s.busy=true;result=&s.native;break;}
+  unlock();return result;
+ }
+ bool release(Handle*p){bool found=false;lock();for(auto&s:slots)if(&s.native==p){found=s.initialized&&s.busy;if(found)s.busy=false;break;}unlock();return found;}
+};
+inline Pool<pthread_mutex_t,4096>& mutex_pool(){static Pool<pthread_mutex_t,4096> p{};return p;}
+inline Pool<pthread_cond_t,4096>& relative_pool(){static Pool<pthread_cond_t,4096> p{};return p;}
+struct Configuration {const pthread_mutexattr_t* mutex;const pthread_condattr_t* relative;unsigned state;};
+inline Configuration& configuration(){static Configuration c{};return c;}
+struct PrimeResult {size_t mutexes,relative;};
+inline PrimeResult prime(pthread_mutexattr_t* ma,pthread_condattr_t* ca){
+ auto&c=configuration();unsigned expected=0;
+ if(!__atomic_compare_exchange_n(&c.state,&expected,1u,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))return {0,0};
+ c.mutex=ma;c.relative=ca;
+ PrimeResult result{mutex_pool().prime(pthread_mutex_init,ma),relative_pool().prime(pthread_cond_init,ca)};
+ __atomic_store_n(&c.state,2u,__ATOMIC_RELEASE);return result;
+}
+class MutexLease {
+ pthread_mutex_t local{};pthread_mutex_t*active=nullptr;bool pooled=false;
+ public:
+ MutexLease()=default;MutexLease(const MutexLease&)=delete;MutexLease&operator=(const MutexLease&)=delete;
+ int init(const pthread_mutexattr_t*attr){
+  if(active)return EBUSY;int saved=errno;
+  if(__atomic_load_n(&configuration().state,__ATOMIC_ACQUIRE)==2&&attr==configuration().mutex){active=mutex_pool().acquire();pooled=active!=nullptr;}
+  int result=0;if(!active){result=pthread_mutex_init(&local,attr);if(!result)active=&local;}
+  errno=saved;return result;
+ }
+ int destroy(){
+  if(!active)return EINVAL;int saved=errno;int result=0;
+  if(pooled){
+   // Do not return a locked native mutex to another owner.
+   result=pthread_mutex_trylock(active);
+   if(!result){result=pthread_mutex_unlock(active);if(!result&&!mutex_pool().release(active))result=EINVAL;}
+  }else result=pthread_mutex_destroy(active);
+  if(!result){active=nullptr;pooled=false;}errno=saved;return result;
+ }
+ pthread_mutex_t*get(){return active?active:&local;}
+ operator pthread_mutex_t*(){return get();}
+};
+class CondLease {
+ pthread_cond_t local{};pthread_cond_t*active=nullptr;unsigned kind=0;
+ public:
+ CondLease()=default;CondLease(const CondLease&)=delete;CondLease&operator=(const CondLease&)=delete;
+ int init(const pthread_condattr_t*attr){
+  if(active)return EBUSY;int saved=errno;
+  if(__atomic_load_n(&configuration().state,__ATOMIC_ACQUIRE)==2){
+   if(attr==configuration().relative){active=relative_pool().acquire();if(active)kind=1;}
+  }
+  int result=0;if(!active){result=pthread_cond_init(&local,attr);if(!result)active=&local;}
+  errno=saved;return result;
+ }
+ // Caller must ensure no waiter remains, as required for native cond_destroy.
+ int destroy(){
+  if(!active)return EINVAL;int saved=errno;
+  int result=kind==1?(relative_pool().release(active)?0:EINVAL):pthread_cond_destroy(active);
+  if(!result){active=nullptr;kind=0;}errno=saved;return result;
+ }
+ pthread_cond_t*get(){return active?active:&local;}
+ operator pthread_cond_t*(){return get();}
+};
+}
+#endif
+#endif
