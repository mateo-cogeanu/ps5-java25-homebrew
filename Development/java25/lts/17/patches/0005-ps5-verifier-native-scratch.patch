--- a/src/java.base/share/native/libverify/check_code.c
+++ b/src/java.base/share/native/libverify/check_code.c
@@ -124,0 +125,22 @@
+#endif
+
+#ifdef __PROSPERO__
+extern void *JVM_PS5AllocateVerifierScratch(size_t size);
+extern void JVM_PS5ReleaseVerifierScratch(void *buffer);
+
+static void *ps5_verifier_calloc(size_t count, size_t size)
+{
+    if (size != 0 && count > (size_t)-1 / size) {
+        return NULL;
+    }
+    size_t bytes = count * size;
+    void *buffer = JVM_PS5AllocateVerifierScratch(bytes);
+    if (buffer != NULL) {
+        memset(buffer, 0, bytes);
+    }
+    return buffer;
+}
+
+#define malloc JVM_PS5AllocateVerifierScratch
+#define calloc ps5_verifier_calloc
+#define free JVM_PS5ReleaseVerifierScratch
