+#ifdef __PROSPERO__
+// libverify owns these buffers and releases them through the paired entry.
+extern "C" __attribute__((visibility("default"))) void* JVM_PS5AllocateVerifierScratch(size_t size) {
+  return ps5_native_heap::allocate(size);
+}
+
+extern "C" __attribute__((visibility("default"))) void JVM_PS5ReleaseVerifierScratch(void* buffer) {
+  ps5_native_heap::release(buffer);
+}
+#endif
