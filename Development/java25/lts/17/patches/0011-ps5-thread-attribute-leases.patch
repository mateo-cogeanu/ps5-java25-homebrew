+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PS5_THREAD_ATTRIBUTES_HPP
+#define PS5_THREAD_ATTRIBUTES_HPP
+#include <pthread.h>
+#include <errno.h>
+// Real pthread attributes initialized before native-heap pressure. Slots are
+// borrowed exclusively, passed by address without copying opaque objects, and
+// retained for the process lifetime. pthread_create consumes attributes before
+// it returns; the lease may then return its slot even for a detached child.
+namespace ps5_thread_attributes {
+constexpr unsigned capacity = 32;
+struct Slot { pthread_attr_t value; bool valid, busy; };
+template<bool Query=false> inline Slot* slots() { static Slot values[capacity] = {}; return values; }
+template<bool Query=false> inline unsigned* state() { static unsigned value = 0; return &value; }
+template<bool Query=false> inline unsigned* lock_word() { static unsigned value = 0; return &value; }
+inline void pause() {
+#if defined(__x86_64__)
+    __asm__ volatile("pause");
+#elif defined(__aarch64__)
+    __asm__ volatile("yield");
+#endif
+}
+template<bool Query=false> inline void lock() { while (__atomic_exchange_n(lock_word<Query>(),1u,__ATOMIC_ACQUIRE)) pause(); }
+template<bool Query=false> inline void unlock() { __atomic_store_n(lock_word<Query>(),0u,__ATOMIC_RELEASE); }
+template<bool Query> inline void initialize_pool() {
+    unsigned expected = 0;
+    if (__atomic_compare_exchange_n(state<Query>(),&expected,1u,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)) {
+        for (unsigned i=0;i<capacity;++i) slots<Query>()[i].valid = pthread_attr_init(&slots<Query>()[i].value) == 0;
+        __atomic_store_n(state<Query>(),2u,__ATOMIC_RELEASE);
+    } else while (__atomic_load_n(state<Query>(),__ATOMIC_ACQUIRE) != 2u) pause();
+}
+// Stack-query attributes must never be reused for creation: get_np may set
+// an explicit live stack address in the opaque object. Prime both domains early.
+inline void initialize() { initialize_pool<false>(); initialize_pool<true>(); }
+template<bool Query> class BasicLease {
+    Slot* slot = nullptr;
+    pthread_attr_t local;
+    bool local_valid = false;
+public:
+    pthread_attr_t* value = nullptr;
+    BasicLease() = default;
+    BasicLease(const BasicLease&) = delete;
+    BasicLease& operator=(const BasicLease&) = delete;
+    int acquire() {
+        initialize();
+        lock<Query>();
+        for (unsigned i=0;i<capacity;++i) if (slots<Query>()[i].valid && !slots<Query>()[i].busy) {
+            slot=&slots<Query>()[i]; slot->busy=true; value=&slot->value; break;
+        }
+        unlock<Query>();
+        if (slot != nullptr) return 0;
+        int result=pthread_attr_init(&local);
+        if (result == 0) { local_valid=true; value=&local; }
+        return result;
+    }
+    void release() {
+        int saved_errno=errno;
+        if (slot != nullptr) { lock<Query>(); slot->busy=false; unlock<Query>(); slot=nullptr; }
+        if (local_valid) { pthread_attr_destroy(&local); local_valid=false; }
+        value=nullptr; errno=saved_errno;
+    }
+    ~BasicLease() { release(); }
+};
+using Lease = BasicLease<false>;
+using QueryLease = BasicLease<true>;
+}
+#endif
