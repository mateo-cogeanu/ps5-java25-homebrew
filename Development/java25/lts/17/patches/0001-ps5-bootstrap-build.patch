@@ -524,0 +525,20 @@ Java_sun_nio_fs_UnixNativeDispatcher_getlinelen(JNIEnv* env, jclass this, jlong
+    int saved_errno;
+#ifdef __PROSPERO__
+    // Only the length is needed here. The SDK has fgetc but no getline;
+    // consume through newline without allocating or interpreting NUL bytes.
+    ssize_t res = 0;
+    int ch;
+    while ((ch = fgetc(fp)) != EOF) {
+        if (res == SSIZE_MAX) {
+            errno = EOVERFLOW;
+            res = -1;
+            break;
+        }
+        ++res;
+        if (ch == '\n')
+            break;
+    }
+    if (ch == EOF && (res == 0 || ferror(fp)))
+        res = -1;
+    saved_errno = errno;
+#else
