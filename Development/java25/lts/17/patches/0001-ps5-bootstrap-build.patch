diff --git a/b/src/hotspot/share/runtime/ps5LtsBootstrap.hpp b/src/hotspot/share/runtime/ps5LtsBootstrap.hpp
new file mode 100644
index 0000000..24a4703
--- /dev/null
+++ b/src/hotspot/share/runtime/ps5LtsBootstrap.hpp
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SHARE_RUNTIME_PS5LTSBOOTSTRAP_HPP
+#define SHARE_RUNTIME_PS5LTSBOOTSTRAP_HPP
+#ifdef __PROSPERO__
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+// A fixed small probe log; no stdio, VM allocation or VM lock is needed.
+inline void ps5_lts_trace(const char *text) {
+  int saved = errno;
+  int fd = ::open("/download0/java17-vm-trace.log", O_CREAT | O_WRONLY | O_APPEND, 0600);
+  if (fd >= 0) {
+    size_t left = ::strlen(text), sent = 0;
+    while (sent < left) {
+      ssize_t n = ::write(fd, text + sent, left - sent);
+      if (n > 0) sent += static_cast<size_t>(n);
+      else if (n < 0 && errno == EINTR) continue;
+      else break;
+    }
+    (void)::write(fd, "\n", 1);
+    (void)::close(fd);
+  }
+  errno = saved;
+}
+inline void ps5_lts_trace_number(const char* label, uint64_t value) {
+ char text[96];size_t n=0;
+ while(*label&&n<64)text[n++]=*label++;
+ text[n++]='0';text[n++]='x';const char hex[]="0123456789abcdef";
+ for(int shift=60;shift>=0;shift-=4)text[n++]=hex[(value>>shift)&15];
+ text[n]=0;ps5_lts_trace(text);
+}
+
+#else
+inline void ps5_lts_trace(const char *) {}
+inline void ps5_lts_trace_number(const char *, uint64_t) {}
+#endif
+#endif
diff --git a/b/src/hotspot/share/runtime/ps5SignalContext.hpp b/src/hotspot/share/runtime/ps5SignalContext.hpp
new file mode 100644
index 0000000..2fa275e
--- /dev/null
+++ b/src/hotspot/share/runtime/ps5SignalContext.hpp
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SHARE_RUNTIME_PS5SIGNALCONTEXT_HPP
+#define SHARE_RUNTIME_PS5SIGNALCONTEXT_HPP
+#include <stddef.h>
+#ifdef __PROSPERO__
+// PS5 signal frames have 48 reserved bytes after the 16-byte signal mask.
+// Use this view only for register members; never replace the kernel's pointer.
+struct Ps5SignalContext {
+ unsigned char mask_and_reserved[0x40];
+ mcontext_t uc_mcontext;
+};
+static_assert(offsetof(ucontext_t,uc_mcontext)==0x10,"Re-audit changed SDK context layout");
+static_assert(offsetof(Ps5SignalContext,uc_mcontext)==0x40,"PS5 machine context offset");
+static_assert(offsetof(Ps5SignalContext,uc_mcontext)+offsetof(mcontext_t,mc_rip)==0xe0,"PS5 RIP offset");
+static_assert(offsetof(Ps5SignalContext,uc_mcontext)+offsetof(mcontext_t,mc_rsp)==0xf8,"PS5 RSP offset");
+inline Ps5SignalContext* ps5_signal_context(ucontext_t*uc){return reinterpret_cast<Ps5SignalContext*>(uc);}
+inline const Ps5SignalContext* ps5_signal_context(const ucontext_t*uc){return reinterpret_cast<const Ps5SignalContext*>(uc);}
+#else
+template<class C> inline C* ps5_signal_context(C*uc){return uc;}
+#endif
+#endif
