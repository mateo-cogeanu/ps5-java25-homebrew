+/* SPDX-License-Identifier: GPL-2.0-only
+ * PS5 port diagnostic helper: record startup milestones without stdio,
+ * JVM allocation, JVM locks or signal recovery.
+ */
+#ifndef SHARE_RUNTIME_PS5STARTUPTRACE_HPP
+#define SHARE_RUNTIME_PS5STARTUPTRACE_HPP
+#ifdef __PROSPERO__
+#include <fcntl.h>
+#include <unistd.h>
+#include <string.h>
+#include <errno.h>
+inline void ps5_vm_trace(const char *stage) {
+  int fd = ::open("/download0/java25-vm-trace.log", O_CREAT | O_WRONLY | O_APPEND, 0600);
+  if (fd < 0) return;
+  size_t length = ::strlen(stage);
+  size_t sent = 0;
+  while (sent < length) {
+    ssize_t written = ::write(fd, stage + sent, length - sent);
+    if (written > 0) sent += written;
+    else if (written < 0 && errno == EINTR) continue;
+    else break;
+  }
+  (void)::write(fd, "\n", 1);
+  (void)::close(fd);
+}
+#else
+inline void ps5_vm_trace(const char *) {}
+#endif
+#endif
